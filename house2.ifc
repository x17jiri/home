#39886=IFCPROPERTYSINGLEVALUE('RightPanelTables',$,IFCLABEL('[{"kind": "material_legend", "title": "LEGENDA MATERI\X2\00C1\X0\L\X2\016E\X0\", "items": [{"pattern": "rockwool-wave", "description": "Fas\X2\00E1\X0\dn\X2\00ED\X0\ izolace 200 mm"}, {"pattern": "reinforced-concrete", "description": "\X2\017D\X0\elezobetonov\X2\00FD\X0\ v\X2\011B\X0\nec a dobeton\X2\00E1\X0\vka"}, {"pattern": "purlin-support-footprint", "description": "Ulo\X2\017E\X0\en\X2\00ED\X0\ sloupku krovu"}]}, {"kind": "miako_beam_schedule", "title": "SPECIFIKACE MIAKO NOSN\X2\00CD\X0\K\X2\016E\X0\", "items": [{"location": "0.01, 0.02", "length": 3750, "count": 14, "slab_guid": "2JnGolefDDYvNNzAv8PHn3"}, {"location": "0.03", "length": 3500, "count": 11, "slab_guids": ["3esdDpzIT3_96bW3eS19uv", "1QVSqTvBPEFAUe8b4$xVa0"]}, {"location": "0.04, 0.05", "length": 2500, "count": 16, "slab_guids": ["3ialTzslD7M8HJXA4e4M_z", "1m1QXc0p94h9UpzyWfHlPJ", "1lNi2oMB92OgJfALUuHfqK"]}]}, {"kind": "notes", "title": "POZN\X2\00C1\X0\MKY", "items": [{"text": "Pokoje 1 a 2: spole\X2\010D\X0\n\X2\00FD\X0\ strop, 14 nosn\X2\00ED\X0\k\X2\016F\X0\ 3750 mm ve sm\X2\011B\X0\ru Y, 13 \X2\0161\X0\irok\X2\00FD\X0\ch vlo\X2\017E\X0\kov\X2\00FD\X0\ch \X2\0159\X0\ad."}, {"text": "Pokoje 1 a 2: \X2\016100ED0159\X0\ka 8285 mm, vyst\X2\0159\X0\ed\X2\011B\X0\no nad ob\X2\011B\X0\ma pokoji; mezery 5 mm mezi nosn\X2\00ED\X0\ky a vlo\X2\017E\X0\kami."}, {"text": "Ulo\X2\017E\X0\en\X2\00ED\X0\ na p\X2\015900ED010D\X0\n\X2\00E9\X0\ a zahradn\X2\00ED\X0\ st\X2\011B\X0\n\X2\011B\X0\: 182.5 mm na ka\X2\017E\X0\d\X2\00E9\X0\m konci."}, {"text": "0.03: nosn\X2\00ED\X0\ky 3500 mm; ulo\X2\017E\X0\en\X2\00ED\X0\ obvod 130 mm / st\X2\0159\X0\ed 110 mm."}, {"text": "0.05: nosn\X2\00ED\X0\ky 2500 mm; ulo\X2\017E\X0\en\X2\00ED\X0\ 120 mm na obou konc\X2\00ED\X0\ch."}, {"text": "Ulo\X2\017E\X0\en\X2\00ED\X0\ nosn\X2\00ED\X0\k\X2\016F\X0\ je nutn\X2\00E9\X0\ upravit podle st\X2\011B\X0\n v 1.NP."}, {"text": "Pod sloupky vaznic: d\X2\011B\X0\len\X2\00E9\X0\ HEB180 bez obetonov\X2\00E1\X0\n\X2\00ED\X0\, v\X2\00FD0161\X0\kov\X2\011B\X0\ vyst\X2\0159\X0\ed\X2\011B\X0\n\X2\00E9\X0\ ve strop\X2\011B\X0\; ulo\X2\017E\X0\en\X2\00ED\X0\ 100 mm na v\X2\0161\X0\ech st\X2\011B\X0\n\X2\00E1\X0\ch."}, {"text": "Otvor schodi\X2\0161\X0\t\X2\011B\X0\: 3000 mm od vnit\X2\0159\X0\n\X2\00ED\X0\ho l\X2\00ED\X0\ce uli\X2\010D\X0\n\X2\00ED\X0\ st\X2\011B\X0\ny."}, {"text": "Schodi\X2\0161\X0\t\X2\011B\X0\: HEB180 s ulo\X2\017E\X0\en\X2\00ED\X0\m 100 mm."}, {"text": "0.03/0.04/0.05: spole\X2\010D\X0\n\X2\00E1\X0\ osnova se suter\X2\00E9\X0\nem; osa prvn\X2\00ED\X0\ho nosn\X2\00ED\X0\ku 215 mm od osy zahradn\X2\00ED\X0\ p\X2\015900ED010D\X0\n\X2\00E9\X0\ st\X2\011B\X0\ny."}, {"text": "0.05: prvn\X2\00ED\X0\ nosn\X2\00ED\X0\k a \X2\00FA\X0\zk\X2\00E1\X0\ \X2\0159\X0\ada vlo\X2\017E\X0\ek vynech\X2\00E1\X0\ny kv\X2\016F\X0\li kom\X2\00ED\X0\nu, stejn\X2\011B\X0\ jako v S.04."}, {"text": "0.05: mezera k zahradn\X2\00ED\X0\ p\X2\015900ED010D\X0\n\X2\00E9\X0\ st\X2\011B\X0\n\X2\011B\X0\ vypln\X2\011B\X0\na betonem; odstup od kom\X2\00ED\X0\nu 30 mm po cel\X2\00E9\X0\m obvodu."}]}]'),$);
